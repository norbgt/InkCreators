#!/bin/bash
# O Finder executa isto sem abrir Terminal — é por isso que este
# aplicativo existe e os .command foram para bin/atalhos-terminal.
# Da posição deste arquivo até a raiz do projeto são três níveis:
# Contents/MacOS/run → .app → pasta principal.
AQUI="$(cd "$(dirname "$0")/../../.." && pwd)"
if [ ! -x "$AQUI/bin/prototipo.sh" ]; then
  osascript -e 'display alert "Ink Creators" message "Não encontrei bin/prototipo.sh. O aplicativo precisa ficar dentro da pasta do projeto — se você o moveu ou copiou para outro lugar, traga de volta." as critical'
  exit 1
fi
exec "$AQUI/bin/prototipo.sh" abrir
