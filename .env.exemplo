# Modelo de variáveis de ambiente. Copie para .env e preencha.
# O .env real está bloqueado no .gitignore e NUNCA deve ser versionado
# nem enviado por e-mail, chat ou dentro de arquivo compactado.

# ─── Supabase ──────────────────────────────────────────────────────
# Chave publicável: pode aparecer no navegador. A segurança de verdade
# vem das políticas de RLS, não do sigilo desta chave.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Chave de service role: ignora TODAS as políticas de RLS.
# Só no servidor. Nunca com prefixo VITE_. Nunca no navegador.
SUPABASE_SERVICE_ROLE_KEY=

# ─── IA (Google AI Studio) ─────────────────────────────────────────
# Substitui o gateway proprietário do Lovable. Só servidor.
GOOGLE_AI_API_KEY=

# ─── Google Maps ───────────────────────────────────────────────────
# Servidor: usada na geocodificação.
GOOGLE_MAPS_API_KEY=

# Navegador: fica visível no código do cliente por natureza. Restrinja
# por referenciador HTTP no Google Cloud Console, senão qualquer pessoa
# pode usá-la e a fatura chega para você.
VITE_GOOGLE_MAPS_BROWSER_KEY=
